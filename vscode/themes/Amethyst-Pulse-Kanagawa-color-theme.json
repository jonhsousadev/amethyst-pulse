{
  "name": "Amethyst Pulse Kanagawa",
  "type": "dark",
  "colors": {
    // --- UI: TITLE BAR ---
    "titleBar.activeBackground": "#16161D",
    "titleBar.activeForeground": "#DCD7BA",
    "titleBar.inactiveBackground": "#16161D",
    "titleBar.inactiveForeground": "#727169",
    "titleBar.border": "#1F1F28",

    // --- UI: TABS ---
    "editorGroupHeader.tabsBackground": "#16161D",
    "tab.activeBackground": "#181820",
    "tab.activeForeground": "#DCD7BA",
    "tab.inactiveBackground": "#16161D",
    "tab.inactiveForeground": "#727169",
    "tab.activeBorderTop": "#957FB8",
    "tab.border": "#1F1F28",

    // --- UI: STATUS BAR ---
    "statusBar.background": "#16161D",
    "statusBar.foreground": "#DCD7BA",
    "statusBar.border": "#1F1F28",
    "statusBarItem.hoverBackground": "#2A2A37",

    // --- UI: COMMAND CENTER ---
    "commandCenter.background": "#2A2A37",
    "commandCenter.border": "#363646",
    "commandCenter.foreground": "#DCD7BA",

    // --- UI: INPUTS, DROPDOWNS & SETTINGS ---
    "input.background": "#2A2A37",
    "input.foreground": "#DCD7BA",
    "input.border": "#363646",
    "input.placeholderForeground": "#727169",
    "dropdown.background": "#2A2A37",
    "dropdown.border": "#363646",
    "dropdown.foreground": "#DCD7BA",
    "settings.headerForeground": "#957FB8",
    "settings.modifiedItemIndicator": "#957FB8",

    // --- UI: BUTTONS & LISTS ---
    "button.background": "#957FB8",
    "button.foreground": "#16161D",
    "button.hoverBackground": "#7E9CD8",
    "list.hoverBackground": "#2A2A37",
    "list.activeSelectionBackground": "#223249",
    "list.activeSelectionForeground": "#957FB8",
    "list.inactiveSelectionBackground": "#1F1F28",
    "list.focusBackground": "#363646",

    // --- UI: SIDEBAR & TREE ---
    "sideBar.background": "#16161D",
    "sideBar.foreground": "#DCD7BA",
    "sideBar.border": "#1F1F28",
    "sideBarSectionHeader.background": "#16161D",
    "sideBarSectionHeader.foreground": "#957FB8",
    "tree.indentGuidesStroke": "#363646",

    // --- UI: ACTIVITY BAR ---
    "activityBar.background": "#16161D",
    "activityBar.foreground": "#957FB8",
    "activityBar.border": "#1F1F28",

    // --- BADGES ---
    "activityBarBadge.background": "#FFA066",
    "activityBarBadge.foreground": "#16161D",
    "badge.background": "#957FB8",
    "badge.foreground": "#16161D",

    // --- EDITOR ---
    "editor.background": "#181820",
    "editor.foreground": "#DCD7BA",
    "editorCursor.foreground": "#FFA066",
    "editor.lineHighlightBackground": "#363646",
    "editor.selectionBackground": "#54546D99",
    "editorIndentGuide.background1": "#2A2A37",
    "editorIndentGuide.activeBackground1": "#957FB8",
    "editorLineNumber.activeForeground": "#957FB8",
    "editorLineNumber.foreground": "#54546D",
    "breadcrumb.foreground": "#727169",
    "breadcrumb.activeSelectionForeground": "#DCD7BA",
    "editorLightBulb.foreground": "#FFA066",

    // --- EDITOR GROUPS & PANELS ---
    "editorGroup.border": "#1F1F28",
    "editorGroupHeader.border": "#1F1F28",
    "editorGroup.dropBackground": "#1F1F2880",
    "panel.border": "#1F1F28",

    // --- TERMINAL ---
    "terminal.background": "#181820",
    "terminal.foreground": "#DCD7BA",
    "terminalCursor.foreground": "#FFA066",
    "terminal.ansiBlack": "#16161D",
    "terminal.ansiBlue": "#7E9CD8",
    "terminal.ansiCyan": "#7AA89F",
    "terminal.ansiGreen": "#98BB6C",
    "terminal.ansiMagenta": "#957FB8",
    "terminal.ansiRed": "#E46876",
    "terminal.ansiWhite": "#DCD7BA",
    "terminal.ansiYellow": "#E6C384",
    "terminal.ansiBrightBlack": "#54546D",
    "terminal.ansiBrightBlue": "#7E9CD8",
    "terminal.ansiBrightCyan": "#7AA89F",
    "terminal.ansiBrightGreen": "#98BB6C",
    "terminal.ansiBrightMagenta": "#957FB8",
    "terminal.ansiBrightRed": "#E46876",
    "terminal.ansiBrightWhite": "#DCD7BA",
    "terminal.ansiBrightYellow": "#E6C384",

    // --- CURRENT SCOPE HIGHLIGHT ---
    "editor.selectionHighlightBackground": "#36364680",
    "editor.selectionHighlightBorder": "#957FB8"
  },
  "tokenColors": [
    // --- JAVA: CLASSES, METHODS, TYPES, ETC. ---
    {
      "name": "Java Class Name",
      "scope": ["entity.name.type.class.java"],
      "settings": { "foreground": "#7AA89F", "fontStyle": "bold" }
    },
    {
      "name": "Java Interface Name",
      "scope": ["entity.name.type.interface.java"],
      "settings": { "foreground": "#7E9CD8", "fontStyle": "italic" }
    },
    {
      "name": "Java Method Name",
      "scope": ["entity.name.function.java"],
      "settings": { "foreground": "#7FB4CA", "fontStyle": "italic" }
    },
    {
      "name": "Java Field/Variable",
      "scope": ["variable.other.java"],
      "settings": { "foreground": "#98BB6C" }
    },
    {
      "name": "Java Keywords",
      "scope": ["keyword.other.java", "storage.type.java"],
      "settings": { "foreground": "#957FB8", "fontStyle": "bold" }
    },
    {
      "name": "Java Annotation",
      "scope": ["storage.type.annotation.java", "meta.annotation.java"],
      "settings": { "foreground": "#C0A36E", "fontStyle": "italic" }
    },
    {
      "name": "Java Package/Import",
      "scope": ["storage.modifier.import.java", "storage.modifier.package.java"],
      "settings": { "foreground": "#727169", "fontStyle": "italic" }
    },
    {
      "name": "Java String",
      "scope": ["string.quoted.double.java", "string.quoted.single.java"],
      "settings": { "foreground": "#98BB6C" }
    },
    {
      "name": "Java Number",
      "scope": ["constant.numeric.java"],
      "settings": { "foreground": "#D27E99" }
    },
    {
      "name": "Java Comment",
      "scope": ["comment.line.double-slash.java", "comment.block.documentation.java"],
      "settings": { "foreground": "#727169", "fontStyle": "italic" }
    },
    {
      "name": "Control Structures (if, else, for, while, return)",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#FFA066",
        "fontStyle": "italic bold"
      }
    },
    // --- CSS: AT-RULES (@import, @media, @keyframes, @supports) ---
    {
      "name": "CSS/SCSS At-Rules (@import, @use, @forward, @media, @keyframes, @supports, @mixin, @include, @extend)",
      "scope": [
        "keyword.control.at-rule.import.css",
        "keyword.control.at-rule.import.scss",
        "keyword.control.at-rule.use.scss",
        "keyword.control.at-rule.forward.scss",
        "keyword.control.at-rule.media.css",
        "keyword.control.at-rule.media.scss",
        "keyword.control.at-rule.keyframes.css",
        "keyword.control.at-rule.keyframes.scss",
        "keyword.control.at-rule.supports.css",
        "keyword.control.at-rule.supports.scss",
        "keyword.control.at-rule.mixin.scss",
        "keyword.control.at-rule.include.scss",
        "keyword.control.at-rule.extend.scss",
        "keyword.control.at-rule.function.scss",
        "keyword.control.at-rule.css",
        "punctuation.definition.keyword.css",
        "punctuation.definition.keyword.scss"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    // --- SCSS: FLOW CONTROL (@if, @else, @for, @each, @while, @return) ---
    {
      "name": "SCSS Flow Control (@if, @else, @for, @each, @while, @return, @warn, @debug, @error, @content)",
      "scope": [
        "keyword.control.if.scss",
        "keyword.control.else.scss",
        "keyword.control.for.scss",
        "keyword.control.each.scss",
        "keyword.control.while.scss",
        "keyword.control.return.scss",
        "keyword.control.warn.scss",
        "keyword.control.content.scss",
        "keyword.control.at-rule.if.scss",
        "keyword.control.at-rule.else.scss",
        "keyword.control.at-rule.for.scss",
        "keyword.control.at-rule.each.scss",
        "keyword.control.at-rule.while.scss",
        "keyword.control.at-rule.return.scss"
      ],
      "settings": {
        "foreground": "#FFA066",
        "fontStyle": "italic bold"
      }
    },
    // --- CSS: PSEUDO-CLASSES & PSEUDO-ELEMENTS ---
    {
      "name": "CSS Pseudo-Classes (:hover, :focus, :nth-child, etc.)",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-class.scss",
        "punctuation.definition.entity.css",
        "punctuation.definition.entity.scss"
      ],
      "settings": {
        "foreground": "#7E9CD8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Pseudo-Elements (::before, ::after, etc.)",
      "scope": [
        "entity.other.attribute-name.pseudo-element.css",
        "entity.other.attribute-name.pseudo-element.scss"
      ],
      "settings": {
        "foreground": "#7AA89F",
        "fontStyle": "italic"
      }
    },
    // --- CSS: VENDOR PREFIXES ---
    {
      "name": "CSS Vendor-Prefixed Properties (-webkit-, -moz-, etc.)",
      "scope": [
        "support.type.vendored-property-name.css",
        "support.type.vendored-property-name.scss"
      ],
      "settings": {
        "foreground": "#7AA89F"
      }
    },
    // --- SCSS: VARIABLES ---
    {
      "name": "SCSS Variables ($variable)",
      "scope": [
        "variable.scss",
        "variable.other.scss",
        "variable.other.less",
        "variable.less"
      ],
      "settings": {
        "foreground": "#E6C384",
        "fontStyle": "bold"
      }
    },
    // --- SCSS: MIXIN & FUNCTION NAMES ---
    {
      "name": "SCSS Mixin & Function Names",
      "scope": [
        "entity.name.function.scss",
        "entity.name.function.less",
        "support.function.misc.scss"
      ],
      "settings": {
        "foreground": "#7E9CD8",
        "fontStyle": "italic"
      }
    },
    // --- SCSS: INTERPOLATION #{} ---
    {
      "name": "SCSS Interpolation Delimiters (#{ and })",
      "scope": [
        "punctuation.definition.interpolation.begin.bracket.curly.scss",
        "punctuation.definition.interpolation.end.bracket.curly.scss",
        "punctuation.section.interpolation.begin.scss",
        "punctuation.section.interpolation.end.scss"
      ],
      "settings": {
        "foreground": "#E46876",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SCSS Variable inside Interpolation",
      "scope": [
        "variable.interpolation.scss"
      ],
      "settings": {
        "foreground": "#98BB6C"
      }
    },
    // --- SCSS: PLACEHOLDER SELECTORS ---
    {
      "name": "SCSS Placeholder Selectors (%placeholder)",
      "scope": [
        "entity.other.attribute-name.placeholder.css",
        "entity.other.attribute-name.placeholder.scss"
      ],
      "settings": {
        "foreground": "#C0A36E",
        "fontStyle": "bold"
      }
    },
    // --- OPERATORS ---
    {
      "name": "Comparison Operators (==, ===, !=, !==, >, <, >=, <=)",
      "scope": [
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#C0A36E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Logical Operators (!, &&, ||)",
      "scope": [
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#98BB6C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Assignment Operators (=, +=, -=, etc.)",
      "scope": [
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#7E9CD8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Other Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E46876"
      }
    },
    // --- .env files ---
    {
      "name": ".env Keys",
      "scope": [
        "variable.other.env",
        "support.type.property-name.env"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    {
      "name": ".env Equal Sign",
      "scope": [
        "keyword.operator.assignment.env"
      ],
      "settings": {
        "foreground": "#7E9CD8"
      }
    },
    {
      "name": ".env Values",
      "scope": [
        "string.unquoted.env",
        "constant.other.env"
      ],
      "settings": {
        "foreground": "#E6C384"
      }
    },
    {
      "name": ".env Comments",
      "scope": [
        "comment.line.number-sign.env"
      ],
      "settings": {
        "foreground": "#727169",
        "fontStyle": "italic"
      }
    },
    // --- SQL ---
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.TCL.sql",
        "keyword.other.DCL.sql",
        "keyword.control.sql"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL Functions",
      "scope": [
        "support.function.sql"
      ],
      "settings": {
        "foreground": "#7E9CD8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "SQL Strings",
      "scope": [
        "string.quoted.single.sql",
        "string.quoted.double.sql"
      ],
      "settings": {
        "foreground": "#98BB6C"
      }
    },
    {
      "name": "SQL Numbers",
      "scope": [
        "constant.numeric.sql"
      ],
      "settings": {
        "foreground": "#D27E99"
      }
    },
    {
      "name": "SQL Comments",
      "scope": [
        "comment.line.double-dash.sql",
        "comment.block.sql"
      ],
      "settings": {
        "foreground": "#727169",
        "fontStyle": "italic"
      }
    },
    // --- MongoDB ---
    {
      "name": "MongoDB Operators",
      "scope": [
        "variable.other.mongodb.operator",
        "support.type.property-name.mongodb"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MongoDB Functions",
      "scope": [
        "support.function.mongodb"
      ],
      "settings": {
        "foreground": "#7E9CD8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MongoDB Strings",
      "scope": [
        "string.quoted.double.mongodb",
        "string.quoted.single.mongodb"
      ],
      "settings": {
        "foreground": "#98BB6C"
      }
    },
    {
      "name": "MongoDB Numbers",
      "scope": [
        "constant.numeric.mongodb"
      ],
      "settings": {
        "foreground": "#D27E99"
      }
    },
    {
      "name": "MongoDB Comments",
      "scope": [
        "comment.line.double-slash.mongodb",
        "comment.block.mongodb"
      ],
      "settings": {
        "foreground": "#727169",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Declarations (const, let, var) - Kanagawa Violet",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.declaration.js",
        "keyword.declaration.ts"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import / Export / From keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.control.default",
        "keyword.other.import",
        "keyword.other.export",
        "keyword.other.from"
      ],
      "settings": {
        "foreground": "#957FB8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import wildcard (* in import * from)",
      "scope": [
        "constant.language.import-export-all",
